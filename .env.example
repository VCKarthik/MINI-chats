# TEMPLATE ONLY - never put real values in this file, it is public on GitHub.
# Copy it to .env (which is gitignored) and fill the real values there.

GOOGLE_API_KEY=your-gemini-api-key

# Optional locally, required when deployed: visitors must enter this to use the site
APP_PASSKEY=choose-a-long-passphrase

# Which model answers: "gemini" (API) or "ollama" (local qwen2.5:3b, needs Ollama running)
MODEL_BACKEND=gemini
